# Urban Eyes Chennai — edge device configuration
# Copy this file to edge.env, fill in your values, and run:
#   cp edge.env.example edge.env
# (setup.sh does this automatically)

# Where the Urban Eyes server lives.
# Same-Wi-Fi dev:   http://<your-PC-LAN-IP>:3000/api/potholes   (e.g. http://192.168.1.50:3000/api/potholes)
# Deployed (Render): https://urban-eyes-yk0f.onrender.com/api/potholes
API_ENDPOINT=http://localhost:3000/api/potholes

# Bus identity (shown on the dashboard)
BUS_ROUTE_ID=21G
BUS_ID=CHN-BUS-7822

# YOLO model. Options:
#   - A pothole-trained .pt file          -> /home/pi/models/pothole_v8n.pt
#   - An NCNN folder (fastest on Pi 5)    -> /home/pi/models/pothole_ncnn_model
#   - An ONNX model                       -> /home/pi/models/pothole.onnx
# Generic COCO models (yolo11n.pt etc.) do NOT detect potholes — see README.
MODEL_PATH=yolo11n.pt

# Detection tuning
CONFIDENCE_THRESHOLD=0.60
IMGSZ=320
# Class keywords to report (case-insensitive substring match).
# A custom pothole model usually names its class "pothole".
DETECT_CLASSES=pothole,potholes,hole
# Strict by default: only detections whose class matches DETECT_CLASSES are
# reported. Set to true to report every detection above the confidence
# threshold (useful for single-class models with unusual class names).
DETECT_CLASSES_ANY=false

# GPS module (NEO-6M/8M on GPIO UART). Leave GPS_PORT empty + set COORDS_OVERRIDE
# if you have no GPS module.
GPS_PORT=/dev/serial0
GPS_BAUD=9600
GPS_TIMEOUT=2.0
# Fallback coordinates used when no GPS module is attached, e.g. "13.0827,80.2707"
COORDS_OVERRIDE=

# Embed the captured frame in the upload so the dashboard shows the real photo.
# Set to false to use the server's placeholder images.
SEND_IMAGE=true

# Upload throttling / deduplication
MIN_UPLOAD_INTERVAL=3
DUPLICATE_DISTANCE_M=10

# Camera: true = try CSI (picamera2) first, false = force USB webcam
USE_CSI=true
USB_CAMERA_INDEX=0
