# Urban Eyes Chennai — edge device configuration
# Points at this PC's LAN IP so a Raspberry Pi on the same network can reach it.
# Copy this file to the Pi with the repo, then run: python main.py --verbose

# Deployed (Render) — data shows up on the live website:
API_ENDPOINT=https://urban-eyes-yk0f.onrender.com/api/potholes
# Same-Wi-Fi dev (uncomment and use THIS PC's real LAN IP, e.g. 10.79.150.72):
# API_ENDPOINT=http://10.79.150.72:3000/api/potholes

# Bus identity (shown on the dashboard)
BUS_ROUTE_ID=21G
BUS_ID=CHN-BUS-7822

# YOLO model. Options:
#   - A pothole-trained .pt file          -> /home/pi/models/pothole_v8n.pt
#   - An NCNN folder (fastest on Pi)      -> /home/pi/models/pothole_ncnn_model
#   - An ONNX model                       -> /home/pi/models/pothole.onnx
# Generic COCO models (yolo11n.pt etc.) do NOT detect potholes — see README.
MODEL_PATH=yolo11n.pt

# Detection tuning
CONFIDENCE_THRESHOLD=0.60
IMGSZ=320
DETECT_CLASSES=pothole,potholes,hole
DETECT_CLASSES_ANY=false

# Location source:
#   1) GPS module (NEO-6M/8M on GPIO UART) — used when it has a fix.
#   2) WIFI_LOCATION=true — falls back to the connected network's public-IP
#      location (ipapi.co, city-level accurate, no API key) when there is no
#      GPS fix. Enable this until the GPS module is wired.
#   3) COORDS_OVERRIDE — fixed "lat,lon" used instead of everything above.
GPS_PORT=/dev/serial0
GPS_BAUD=9600
GPS_TIMEOUT=2.0
WIFI_LOCATION=true
WIFI_LOCATION_TTL=300
# Fallback coordinates used when no GPS module is attached, e.g. "13.0827,80.2707"
COORDS_OVERRIDE=

# Embed the captured frame in the upload so the dashboard shows the real photo.
SEND_IMAGE=true

# Upload throttling / deduplication.
# NOTE: with WIFI_LOCATION the coordinates barely move, so a 10 m dedupe would
# suppress every upload after the first one — dedupe is disabled here and rate
# limiting is used instead. Re-enable (10) once real GPS is fitted.
MIN_UPLOAD_INTERVAL=15
DUPLICATE_DISTANCE_M=0

# Camera: true = try CSI (picamera2) first, false = force USB webcam
USE_CSI=true
USB_CAMERA_INDEX=0
