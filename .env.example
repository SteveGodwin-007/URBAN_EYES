# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Live deployment (Render): https://urban-eyes-yk0f.onrender.com
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://urban-eyes-yk0f.onrender.com"

# MongoDB settings for urban-eyes
MONGODB_USER="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_HOST="cluster0.uotjzrt.mongodb.net"
MONGODB_DB="urban-eyes"
